# ==========================================
# SECRETS & ENVIRONMENT VARIABLES (STRICT)
# ==========================================
# Blocks .env in root and ALL subdirectories
**/.env
**/.env.*
.env
.env*
*.env

# API Keys, Certificates & Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
secrets/
config/secrets.*

# ==========================================
# DEPENDENCIES
# ==========================================
node_modules/
jspm_packages/

# ==========================================
# LOGS & TEMPORARY FILES
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# IDEs & OS FILES
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db

