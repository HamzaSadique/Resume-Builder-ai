# ==========================================
# SECRETS & ENVIRONMENT VARIABLES (STRICT)
# ==========================================
# Blocks .env in root and ALL subdirectories
**/.env
**/.env.*
.env
.env*
*.env

# API Keys, Certificates & Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
secrets/
config/secrets.*

# ==========================================
# DEPENDENCIES
# ==========================================
node_modules/
jspm_packages/

# ==========================================
# LOGS & TEMPORARY FILES
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# IDEs & OS FILES
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db
# Ignore directory tree export file
tree.txt


# ==========================================
# FRONTEND / VITE / REACT BUILDS & CACHE
# ==========================================
# Production build folder (Vite outputs to 'dist')
dist/
dist-ssr/
build/

# Vite temporary files & cache
.vite/
*.local

# Testing / Coverage logs
coverage/
*.lcov

# Package Manager lock file overrides (Optional - include if you don't want lock conflicts)
# package-lock.json